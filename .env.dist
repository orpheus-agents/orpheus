# PostgreSQL connection URL shared by the API, worker, and migrations.
# The db hostname refers to the PostgreSQL service in Docker Compose.
DATABASE_URL=postgres://orpheus:orpheus@db:5432/orpheus

# Database probe timeout in seconds for /ready and worker connection checks.
READINESS_TIMEOUT=2

# Path inside the container to the TOML file mounted for both API and worker.
ORPHEUS_CONFIG_FILE=/etc/orpheus/orpheus.toml

# Optional migrations directory inside the container; migrate --dir takes priority.
# ORPHEUS_MIGRATIONS_DIR=/app/migrations

# Development container ownership is selected by Make (host UID/GID on Linux,
# 1000:1000 elsewhere). Override in the shell or Make command, not in this file:
# ORPHEUS_UID=1000 ORPHEUS_GID=1000 make start

# JSON array of Bearer keys accepted by the session API; all keys have equal access.
# Replace the example key before exposing the API outside local development.
PUBLIC_API_KEYS=["local-development-key"]

# Base64url-encoded 32-byte AES-GCM key for explicit sandbox.env values in PostgreSQL.
# Development-only example: generate a unique key for production, share it between
# API and worker, and keep it across restarts to decrypt existing sessions.
ENV_ENCRYPTION_KEY=Zm9yLWxvY2FsLWRldmVsb3BtZW50LW9ubHktMzJieXQ=

# JSON array of worker ENV names clients may select through sandbox.env_from.
# Example: ["GITHUB_TOKEN"]. Listing a name does not pass it to every sandbox.
HARNESS_ENV_ALLOWLIST=[]

# Global limit of sessions reserving execution capacity, including preparation
# and pausing. New work is rejected when the limit is reached.
MAX_CONCURRENT_SESSIONS=50

# Maximum stored tool-result size in bytes (512 KiB); larger results retain
# their beginning and end. Agent messages are not truncated by this limit.
MAX_TOOL_RESULT_BYTES=524288

# Maximum session API request body size in bytes (1 MiB).
MAX_REQUEST_BYTES=1048576

# Seconds allowed for graceful cancellation before killing the harness process.
CANCEL_GRACE_SECONDS=30

# Worker polling interval and individual Codex RPC deadline, in seconds.
WORKER_POLL_SECONDS=1
RPC_TIMEOUT_SECONDS=30

# AgentBox project API key used by the worker to manage sandboxes.
# Set locally or export in the shell; never commit real credentials.
AGENTBOX_API_KEY=

# Model provider API key referenced by the default harness profile.
# Set locally or export in the shell; account-mode profiles use S3 credentials instead.
OPENAI_API_KEY=

# Proxy URL injected as ALL_PROXY when starting any harness; localhost stays direct.
# Defaults to the AgentBox proxy. Set an empty value to disable proxy injection.
SANDBOX_PROXY_URL=socks5h://sandbox-proxy.agentbox.ru:65180
